# Example .env file for blocklist-efficiency-tester
# Copy this file to .env and fill in your values

# Custom blocklist URL with basic auth (optional)
# If set, this will be used instead of the default BLOCKLIST_ID method
# BLOCKLIST_URL=https://admin.api.crowdsec.net/v1/integrations/YOUR_INTEGRATION_ID/content
# BLOCKLIST_USERNAME=your_username
# BLOCKLIST_PASSWORD=your_password

